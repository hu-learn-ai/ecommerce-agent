# ============================================
# 电商领域智能体 - 环境变量模板
# 使用方法: cp .env.example .env && vim .env
# ============================================

# --- LLM (DeepSeek) ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 自托管客服模型（微调后 vLLM 接入）---
# SELF_HOSTED_CS=true 时 Tier1（customer_service / chitchat）走本地 vLLM，
# 探活失败自动回退 DeepSeek，保证系统不因本地服务故障不可用
SELF_HOSTED_CS=false
CS_MODEL_BASE_URL=http://localhost:8000/v1
CS_MODEL_NAME=qwen-cs-7b

# --- Neo4j 图数据库 ---
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# --- MySQL (gmall 业务数据库) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DB=gmall

# --- Embedding 模型 ---
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DIM=768
HF_ENDPOINT=https://hf-mirror.com

# --- 分类模型 ---
CLASSIFY_MODEL_PATH=./models/best
# 域外拒识参考统计（scripts/build_ood_stats.py 生成）
OOD_STATS_PATH=./models/best/ood_stats.npz

# --- NER 模型 ---
NER_MODEL_PATH=./models/ner/best_model

# --- 模型加载期 int8 动态量化（仅 CPU 生效） ---
MODEL_QUANTIZE=true

# --- 推荐：是否启用 LLM 重排（heavy 模型，延迟较高） ---
RECOMMEND_LLM_RERANK=true

# --- FAISS 索引 ---
FAISS_INDEX_PATH=./data/faiss_index

# --- API 服务 ---
API_HOST=0.0.0.0
API_PORT=8002

# --- API 安全（H3 修复：安全默认 fail-closed）---
# API 访问密钥：未配置时所有 /api/* 业务请求将被拒绝（503），
# 必须设置后才能正常调用。生成方式: openssl rand -hex 32
API_ACCESS_KEY=please-change-me
# 可信反向代理注入的用户身份头（如 X-User-Id）。
# 仅当你在代理层完成登录鉴权后注入该头时才配置；无登录体系时留空，
# 订单类回答的收货人/地址将自动脱敏（防越权查单）
TRUSTED_USER_ID_HEADER=
# 是否部署在可信反向代理之后（仅此时信任 X-Forwarded-For 做限流，防伪造绕过）
TRUST_PROXY=false
# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- 记忆系统隐私（M2 修复）---
# 跨会话共享记忆：默认关闭。仅当确认多个会话归属同一用户时才开启
MEMORY_SHARED_ENABLED=false
